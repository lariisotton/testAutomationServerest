{
  "name": "teste-automacao-serverest",
  "version": "1.0.0",
  "description": "Testes E2E automatizados com Cypress para o front-end do ServeRest",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:front": "cypress run --spec \"cypress/e2e/front/**/*.cy.js\"",
    "cy:run:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test": "cypress run",
    "test:front": "npm run cy:run:front",
    "test:api": "npm run cy:run:api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lariisotton/testAutomationServerest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lariisotton/testAutomationServerest/issues"
  },
  "homepage": "https://github.com/lariisotton/testAutomationServerest#readme",
  "devDependencies": {
    "cypress": "^16.1.0",
    "cypress-plugin-api": "^2.12.3"
  }
}
